# =============================================================================
# .gitignore — Protect sensitive research content from accidental commits
# =============================================================================

# ---- Thesis & Paper Documents (DO NOT UPLOAD) ----
*.pdf
*.docx
*.pptx
*.tex
*.bib
*.zip

# ---- Source Code (release after acceptance) ----
*.py
*.pyc
__pycache__/

# ---- Datasets ----
data/
datasets/
WasteRefine.v8*/
zerowaste*/
spectralwaste*/

# ---- Model Weights ----
*.pth
*.pt
*.ckpt
*.h5
*.onnx
models/

# ---- Training Logs & Outputs ----
*.csv
outputs/
logs/
runs/
wandb/

# ---- OS & IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Python ----
*.egg-info/
dist/
build/
.eggs/
*.egg
.env
venv/
env/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb
